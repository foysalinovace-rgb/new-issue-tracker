VITE_ENABLE_DATABASE=true
# Login is server-side and does not require Supabase Auth or SQL.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_ENABLE_GOOGLE_SHEETS_SYNC=true
GOOGLE_SHEET_WEBAPP_URL=your_google_apps_script_web_app_url

# Optional when deploying behind HTTPS:
# APP_ORIGIN=https://your-host.example
# AUTH_COOKIE_SECURE=true
